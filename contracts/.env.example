# Deployer private key (same for all chains)
PRIVATE_KEY=0x_your_private_key_here

# ──────────────────── RPCs ────────────────────
# Source chain
RPC_SOURCE=https://eth-rpc-testnet.polkadot.io/

# Destination chains
RPC_HYPEREVM=https://rpc.hyperliquid-testnet.xyz/evm
RPC_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc

# ──────────────────── Arbitrum Sepolia ISMP (optional) ────────────────────
# Set to use real Hyperbridge IsmpHost instead of deployer (event-relay)
# ISMP_HOST_ADDRESS=0x3435bD7e5895356535459D6087D1eB982DAd90e7

# Etherscan verification (optional)
ETHERSCAN_API_KEY=your_etherscan_key
