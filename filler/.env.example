# Filler Service Configuration

# Filler wallet private key (same key on all chains)
FILLER_PRIVATE_KEY=0x_your_private_key_here

# Source chain (Polkadot Hub Testnet)
RPC_SOURCE=https://eth-rpc-testnet.polkadot.io/
INTENT_GATEWAY_ADDRESS=0x_gateway_on_polkadot_hub

# ──────────────────── Destination Chain ────────────────────
# Arbitrum Sepolia (chain 421614) → Hyperliquid Testnet
RPC_DEST_421614=https://sepolia-rollup.arbitrum.io/rpc
SETTLER_421614=0x_settler_on_arb_sepolia
REGISTRY_421614=0x_registry_on_arb_sepolia
USDC_DEST_421614=0x1baAbB04529D43a73232B713C0FE471f7c7334d5
MODE_421614=event-relay

# ──────────────────── TEE Settlement (Phala Network) ────────────────────
TEE_ENABLED_421614=true
TEE_VERIFIER_421614=0x_tee_verifier_address
TEE_PRIVATE_KEY=0x_mock_tee_key
TEE_AUTO_SETTLE_DELAY_MS=5000

# ──────────────────── Optional Tuning ────────────────────
AUTO_SETTLE_DELAY_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=5000
