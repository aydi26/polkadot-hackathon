# ──────────────────── Filler Service ────────────────────

# Filler wallet private key (needs USDC2 on Arbitrum Sepolia to fill orders)
FILLER_PRIVATE_KEY=0x_your_private_key_here

# ──────────────────── Source Chain (Polkadot Hub Testnet) ────────────────────
RPC_SOURCE=https://eth-rpc-testnet.polkadot.io/
INTENT_GATEWAY_ADDRESS=0x10507B42691793b2E93179300D8008B849189665

# ──────────────────── Destination Chain (Arbitrum Sepolia 421614) ────────────────────
RPC_DEST_421614=https://sepolia-rollup.arbitrum.io/rpc
SETTLER_421614=0x821d957c3cBE99ED4144Ae675AE44fd80E32223d
REGISTRY_421614=0xF1cdf11e0919dE9a2978dF58C621f4487Af24EdF
USDC_DEST_421614=0x1baAbB04529D43a73232B713C0FE471f7c7334d5
MODE_421614=event-relay
PRIVACY_POOL_ADDRESS=0x12569697a1A20a9e850Cce09F2D5e517CDB7a42F
# ──────────────────── TEE Settlement (Phala Network) ────────────────────
TEE_ENABLED_421614=true
TEE_VERIFIER_421614=0xC2DdC138A80136a30E0f5731954d765099ba270A
TEE_PRIVATE_KEY=0x_your_private_key_here
TEE_AUTO_SETTLE_DELAY_MS=5000

# ──────────────────── Optional Tuning ────────────────────
AUTO_SETTLE_DELAY_MS=30000
MAX_RETRIES=3
RETRY_DELAY_MS=5000
